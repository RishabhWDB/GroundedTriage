# Copy to .env and fill in. Never commit .env.
# Loaded by the programs themselves (godotenv / python-dotenv / honcho), not by make.
# If a value contains `$`, wrap it in single quotes ('...') so no loader expands it.

# --- Database (Supabase) ---
# Supabase "Session pooler" string (IPv4, port 5432). Do NOT use the Transaction pooler (6543): it breaks prepared statements in pgx/psycopg.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Database for integration tests; each run creates and drops its own schema here. Never point tests at DATABASE_URL data you care about.
TEST_DATABASE_URL=

# --- LLM: drafter (Groq, OpenAI-compatible) ---
# Groq API key for drafting, meeting extraction and (by default) the judge.
GROQ_API_KEY=
# Drafter model: this system's generator AND the SCRIBE baseline's draft->refine (same on both sides).
GROQ_MODEL=openai/gpt-oss-120b
# OpenAI-compatible base URL (swap to run on another provider).
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Reasoning effort for drafting (low|medium|high; empty = omit).
DRAFT_REASONING_EFFORT=low
# Max output tokens incl. reasoning tokens; truncation raises an error instead of returning partial JSON.
LLM_MAX_TOKENS=4096

# --- LLM: faithfulness judge (different model family from the drafter) ---
# Judge model id.
JUDGE_MODEL=qwen/qwen3.8-27b
# Judge base URL; empty = GROQ_BASE_URL.
JUDGE_BASE_URL=
# Judge API key; empty = GROQ_API_KEY.
JUDGE_API_KEY=
# Reasoning effort for judging (low|medium|high; empty = omit; qwen3 does no reasoning when omitted).
JUDGE_REASONING_EFFORT=medium
# Max output tokens for the judge.
JUDGE_MAX_TOKENS=4096

# --- Services ---
# Base URL the Go api/worker use to reach the Python ml-service.
ML_SERVICE_URL=http://127.0.0.1:8001
# Port the ml-service listens on.
ML_PORT=8001
# Port the Go REST API / review UI listens on.
API_PORT=8080
# How often the worker polls enabled sources (Go duration).
WORKER_POLL_INTERVAL=60s
# Force a torch device (mps|cpu); empty = auto (MPS if available, else CPU).
TORCH_DEVICE=
# Key required in the X-API-Key header by the REST API.
API_KEY=change-me

# --- Email source (IMAP in, SMTP out) ---
# IMAP server host.
IMAP_HOST=
# IMAP port (993 for TLS).
IMAP_PORT=993
# IMAP login user.
IMAP_USER=
# IMAP password / app password.
IMAP_PASSWORD=
# Mailbox to poll.
IMAP_MAILBOX=INBOX
# SMTP server host for outbound replies.
SMTP_HOST=
# SMTP port (587 for STARTTLS).
SMTP_PORT=587
# SMTP login user.
SMTP_USER=
# SMTP password / app password.
SMTP_PASSWORD=
# From address on outbound replies.
SMTP_FROM=

# --- Ticketing source (Zendesk) ---
# Zendesk subdomain (the <x> in <x>.zendesk.com).
ZENDESK_SUBDOMAIN=
# Zendesk agent email used with the API token.
ZENDESK_EMAIL=
# Zendesk API token.
ZENDESK_API_TOKEN=

# --- Google Calendar (meeting scheduler) ---
# Path to the OAuth installed-app client secrets file (gitignored).
GOOGLE_CREDENTIALS_FILE=credentials.json
# Path where the OAuth token is cached (gitignored).
GOOGLE_TOKEN_FILE=token.json
# Calendar to check/create events in.
GOOGLE_CALENDAR_ID=primary
# IANA time zone for working hours.
GOOGLE_TIMEZONE=UTC
